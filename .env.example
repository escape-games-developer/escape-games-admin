VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Opcional. Si se omite se usa /functions/v1/recontactos-api del mismo proyecto.
VITE_RECONTACTOS_API_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/recontactos-api

# Métricas — endpoint de solo lectura del Apps Script de ORIGEN ESCAPE.
# Ver docs/apps-script/README.md. El token se genera con
# configurarTokenMetricas() y NO se commitea: acá va solo el placeholder.
VITE_METRICS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
VITE_METRICS_TOKEN=YOUR_METRICS_TOKEN
